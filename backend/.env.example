# CareerPilot AI - backend configuration template
# Copy this file to .env in the project root (CareerPilot-AI/.env) and fill in your values.
# NEVER commit a .env containing real keys.

# ---- Google Gemini (primary AI provider) -------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any currently supported Gemini model, e.g. gemini-3.1-flash-lite / gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Local AI bridge (optional sandbox fallback) ------------------------
# Disabled by default for Gemini-first operation. When enabled and GEMINI_API_KEY
# is empty, the app tries this local bridge (mini-services/ai-bridge).
AI_BRIDGE_ENABLED=false
AI_BRIDGE_URL=http://127.0.0.1:8010

# ---- Web app ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Uploads -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5

# ---- Scraping ------------------------------------------------------------
SCRAPE_TIMEOUT_SECONDS=15

# ---- Scoring weights (must sum to 1.0) -----------------------------------
WEIGHT_TECHNICAL_SKILLS=0.40
WEIGHT_EDUCATION=0.15
WEIGHT_EXPERIENCE=0.20
WEIGHT_PROJECT_RELEVANCE=0.25

# ---- Database -------------------------------------------------------------
# SQLite file (created automatically next to the backend app)
CP_DATABASE_URL=sqlite:///./career_pilot.db
